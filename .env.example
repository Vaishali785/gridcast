# --- Data source -------------------------------------------------------------
# live    = fetch January 2026 data from the Elexon Insights API (no API key required)
# fixture = load data/fixtures/*.json (SAMPLE data unless you ran scripts/capture_fixtures.py)
DATA_SOURCE=live
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=60
ELEXON_MAX_RETRIES=4
AUTO_REFRESH_ON_EMPTY=true

# --- Analysis window (UK delivery dates) -------------------------------------
DATA_START_DATE=2026-01-01
DATA_END_DATE=2026-01-31
FORECAST_PUBLISH_LOOKBACK_DAYS=14

# --- Decision cutoff (see README) --------------------------------------------
DECISION_CUTOFF_LOCAL_TIME=09:20
DECISION_CUTOFF_TIMEZONE=Europe/London
DECISION_CUTOFF_DAY_OFFSET=-1

# --- Plumbing ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Only needed when the frontend is hosted separately from the API (build-time):
# VITE_API_BASE_URL=https://your-api.example.com
